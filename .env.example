# LLM Configuration — Groq (Phase 3)
# Copy to .env and fill in values, or export in your shell.

# Required — Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (defaults target Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_SEC=30
# LLM_MAX_TOKENS=2048

# Optional app settings (Phase 5)
# APP_USE_LLM=0
# Leave APP_MAX_ROWS unset for full India-wide coverage (~150k restaurants, 500+ cities).
# Set a number only for faster demos (reduces how many cities are loaded):
# APP_MAX_ROWS=20000
